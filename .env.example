# Copiar a .env.local y rellenar cuando lleguen los datos reales del cliente.
# Ver lib/site-config.ts — es el único lugar del código que lee estas variables.
# Ninguna de ellas bloquea el desarrollo si se deja sin configurar (Dossier, cierre).

# Identidad de marca
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# Reservas — sin esta variable, los CTA caen a un mailto: funcional
NEXT_PUBLIC_CALENDLY_URL=

# Chatbot (app/api/chat/route.ts) — sin esta variable, el asistente responde
# en modo degradado y deriva a reservar una llamada
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
